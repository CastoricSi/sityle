{
	"name": "sityle",
	"version": "0.9.3",
	"description": "丹青 — an ink-wash design language: tokens, styles and React components.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CastoricSi/sityle.git"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist/lib"
	],
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/lib/types/index.d.ts",
			"import": "./dist/lib/index.js"
		},
		"./style.css": "./dist/lib/style.css",
		"./style.layer.css": "./dist/lib/style.layer.css",
		"./base.css": "./dist/lib/base.css",
		"./css/*": "./dist/lib/css/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/finish-lib.mjs",
		"typecheck": "tsc -b",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"preversion": "npm run typecheck && npm run lint && npm test && npm run build:lib",
		"release:patch": "npm version patch && git push --follow-tags",
		"release:minor": "npm version minor && git push --follow-tags",
		"release:major": "npm version major && git push --follow-tags",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"prepare": "npm run build:lib"
	},
	"peerDependencies": {
		"motion": "^12.0.0 || ^13.0.0 || ^14.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "^10.0.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"axe-core": "^4.14.0",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"lucide-react": "^1.21.0",
		"motion": "^14.5.0",
		"prettier": "^3.9.10",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.7",
		"wrangler": "4.136.1"
	}
}
